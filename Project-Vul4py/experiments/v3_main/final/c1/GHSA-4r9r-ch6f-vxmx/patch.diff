+def _has_pickle_globals(data: IO[bytes]) -> bool:
+    start = data.tell()
+    try:
+        while True:
+            for opcode, _, _ in pickletools.genops(data):
+                if opcode.name in ("GLOBAL", "INST", "STACK_GLOBAL"):
+                    return True
+    except (ValueError, OverflowError):
+        return False
+    finally:
+        data.seek(start)
